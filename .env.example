PORT=8080
NODE_ENV=production

# Required by the protected admin dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password

# Pairing endpoint protection. Set a long random value in Railway Variables.
PAIRING_API_TOKEN=

# Supabase project settings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use Supabase for encrypted WhatsApp auth state.
AUTH_STORAGE_DRIVER=supabase
SESSION_ID=jarvis-primary
# 32-byte key encoded as 64 hexadecimal characters OR Base64.
SESSION_SECRET=

# Local safety-file location. Do not store movie files here.
AUTH_DIR=/app/auth_info

# TMDB metadata API key
TMDB_API_KEY=
