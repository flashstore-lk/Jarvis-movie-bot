PORT=8080
NODE_ENV=production

# Required by the protected admin dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password

# Pairing endpoint protection
PAIRING_API_TOKEN=

# Supabase project settings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypted Baileys authentication state
AUTH_STORAGE_DRIVER=supabase
SESSION_ID=jarvis-primary
SESSION_SECRET=
AUTH_DIR=/app/auth_info

# TMDB is retained for TV search, IMDb lookup and discovery commands
TMDB_API_KEY=

# CineSubz API (private Railway variable; never commit the real key)
MOCHI_API_KEY=
CINESUBZ_API_BASE_URL=https://mochi-apis.koyeb.app

# GitHub Actions download worker dispatch
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=flashstore-lk/Jarvis-movie-bot
GITHUB_BRANCH=main
DOWNLOAD_WORKFLOW=download-worker.yml

# Must match the GitHub Actions secret RAILWAY_DELIVERY_TOKEN
DOWNLOAD_DELIVERY_TOKEN=

# WhatsApp owner JID
OWNER_JID=
